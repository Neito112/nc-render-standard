(fileIn @"C:\Users\HOMIE\AppData\Local\Autodesk\3dsMax\2024 - 64bit\ENU\usermacros\NC_Render AI-NCRenderSmartBridge_v1.mcr")
(local ok = try ( macros.run "NC-Render AI" "NCRenderSmartBridge_v1" ) catch ("RUNEXC: " + (getCurrentException() as string)))
(format "P2_RUN: %\n" (ok as string))
(format "P2_CLASS: %\n" (classof rltNCRenderPro_v1))
(format "P2_HWNE: %\n" (try (windows.getMaxHWND rltNCRenderPro_v1) catch ("EXC:" + (getCurrentException() as string))))
(format "P2_EXISTS: %\n" (try (windows.exists "NC-Render AI Studio v1.0 \227 CUDA + API + Multi-Renderer") catch ("EXC:" + (getCurrentException() as string))))
(local cd = try ( createDialog rltNCRenderPro_v1 ) catch ("CREATE_EXC:" + (getCurrentException() as string)))
(format "P2_CREATE: %\n" (if cd == undefined then "undefined-ok" else (cd as string)))
(format "P2_DONE\n")
